# ─── NovaCare AI — environment template ────────────────────────────────
# Copy to .env and adjust. Never commit the real .env.

# Fixed demo date so dataset behaviour is deterministic
DEMO_DATE=2026-09-03

# ─── LLM + speech (Groq free tier — get a key at console.groq.com) ────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Free tier: 200k tokens/day per model. When GROQ_MODEL runs out, turns retry on this one.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# TTS model names change; see console.groq.com/docs/text-to-speech. Piper is the fallback.
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=autumn
# Speech: whisper-large-v3 is better than -turbo for Nepali. Empty STT_LANGUAGE = auto-detect ne/en.
GROQ_STT_MODEL=whisper-large-v3
STT_LANGUAGE=
# Nepali voice: ne-NP-HemkalaNeural (female) or ne-NP-SagarNeural (male). English via Edge if Groq TTS is unavailable.
EDGE_VOICE_NE=ne-NP-HemkalaNeural
EDGE_VOICE_EN=en-US-AriaNeural
# Speaking speed, e.g. -10% for a little slower.
EDGE_RATE=+0%
# Most human-sounding voice (optional, paid beyond the free allowance): ElevenLabs eleven_v3
# speaks Nepali. Set both to use it; pick a voice in the ElevenLabs Voice Library.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3
# Seconds of silence before the agent takes its turn. Lower = snappier, higher = fewer cut-offs.
VAD_STOP_SECS=0.6

# ─── Phone calls (Twilio) ─────────────────────────────────────────────
# Trial account works: it can only call numbers you've verified in the Twilio console,
# and Nepal (+977) must be enabled under Voice > Geo permissions.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Any long random string; required in the X-Call-Token header to place a call.
CALL_API_TOKEN=
# Leave empty to use the cloudflared quick tunnel (docker compose --profile phone up -d).
PUBLIC_VOICE_URL=

# ─── Database ────────────────────────────────────────────────────────
DATABASE_URL=sqlite:////data/novacare.db

# ─── Public URLs ─────────────────────────────────────────────────────
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_VOICE_URL=http://localhost:8080

# ─── Voice / WebRTC ──────────────────────────────────────────────────
WEBRTC_STUN_URL=stun:stun.l.google.com:19302

# ─── Security ────────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=http://localhost:3000
MAX_MESSAGE_CHARS=2000
RATE_LIMIT_PER_MINUTE=30
REQUEST_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO
ENVIRONMENT=development
