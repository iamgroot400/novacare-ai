# ─── NovaCare AI — environment template ────────────────────────────────
# Copy to .env and adjust. Never commit the real .env.

# Fixed demo date so dataset behaviour is deterministic
DEMO_DATE=2026-09-03

# ─── Ollama / LLM ─────────────────────────────────────────────────────
# When running via docker compose the backend reaches Ollama at the
# service name. For local dev outside docker use http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b

# ─── ChromaDB (vector store) ─────────────────────────────────────────
CHROMA_HOST=chroma
CHROMA_PORT=8000
# Local embedding model (downloaded once, cached in a volume)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── Database ────────────────────────────────────────────────────────
DATABASE_URL=sqlite:////data/novacare.db

# ─── Public URLs ─────────────────────────────────────────────────────
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_VOICE_URL=http://localhost:8080

# ─── Voice / WebRTC ──────────────────────────────────────────────────
WHISPER_MODEL=base            # tiny | base | small
KOKORO_VOICE=af_heart
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_PASSWORD=

# ─── coturn (optional self-hosted TURN, docker profile "turn") ────────
COTURN_REALM=novacare.local
COTURN_USER=novacare
COTURN_PASSWORD=change-me-please
COTURN_EXTERNAL_IP=

# ─── Security ────────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=http://localhost:3000
MAX_MESSAGE_CHARS=2000
RATE_LIMIT_PER_MINUTE=30
REQUEST_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO
ENVIRONMENT=development
